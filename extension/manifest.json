{
  "manifest_version": 3,
  "name": "한성 학사 도우미 — COSMOS 수집",
  "version": "0.3.1",
  "description": "learn.hansung.ac.kr의 수강 현황을 수집해 한성 학사 도우미에 자동 반영. 앱을 열 때 자동 수집 + LMS 페이지 수집 버튼. 로그인 세션은 브라우저 안에서만 사용된다.",
  "permissions": ["scripting", "tabs", "alarms", "storage"],
  "host_permissions": [
    "https://learn.hansung.ac.kr/*",
    "https://hansung-helper.gyeongbin-38.workers.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.hansung.ac.kr/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://hansung-helper.gyeongbin-38.workers.dev/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
