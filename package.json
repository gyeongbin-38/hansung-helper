{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "d1:migrate:local": "node scripts/_d1_migrate.mjs --local",
    "d1:migrate:remote": "node scripts/_d1_migrate.mjs --remote",
    "d1:backup:local": "node scripts/_d1_export.mjs --local",
    "d1:backup:remote": "node scripts/_d1_export.mjs --remote",
    "d1:restore:rehearsal": "node scripts/_d1_restore_rehearsal.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "dev:backend": "npm run build && node scripts/setup-local.mjs && npm run d1:migrate:local && npm run start",
    "db:migrate:local": "npm run d1:migrate:local",
    "db:local": "wrangler d1 execute site-creator-d1 --local --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint:app": "oxlint app/ lib/",
    "test": "node scripts/run-python.mjs scripts/_run_tests.py",
    "test:db": "node scripts/run-python.mjs tests/account-db.py",
    "test:http": "node scripts/run-python.mjs tests/http-check.py",
    "verify": "npm run typecheck && npm run lint:app && npm test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
