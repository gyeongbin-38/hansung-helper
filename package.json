{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:backend": "npm run build && npm run db:migrate:local && npm run start",
    "build": "vinext build",
    "start": "wrangler dev --local --config dist/server/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "db:local": "wrangler d1 execute site-creator-d1 --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "lint:app": "oxlint app/ lib/",
    "test": "node scripts/run-python.mjs scripts/_run_tests.py",
    "test:db": "node scripts/run-python.mjs tests/account-db.py",
    "test:http": "node scripts/run-python.mjs tests/http-check.py",
    "verify": "npm run typecheck && npm run lint:app && npm test && npm run test:db && npm run build",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260919.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
